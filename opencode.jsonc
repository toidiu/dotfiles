{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "name": "llamacpp",
      "options": {
        "baseURL": "http://127.0.0.1:8080"
      },
      "models": {
        "qwen3-4b": {
          "name": "qwen3-4b"
        }
      }
    }
  },
  "permission": {
    "todowrite": "deny"
  },
  "lsp": true,
  "default_agent": "plan",
  "agent": {
    "build": {
      "prompt": "When you need to read multiple files, delegate the work to a general subagent via the task tool instead of reading them yourself. Use subagents for parallel file reads.",
      "permission": {
        "read": "allow",
        "edit": "ask",
        "glob": "ask",
        "grep": "ask",
        "list": "ask",
        "bash": {
          "rg *": "allow",
          "git *": "allow",
          "npm *": "ask",
          "pnpm *": "ask",
          "pnpm build*": "allow",
          "cargo *": "ask",
          "docker *": "ask",
          "npx *": "ask",
          "pip *": "ask",
          "make *": "ask",
          "node *": "ask",
          "python*": "ask",
          "rustup *": "ask",
          "curl *": "ask",
          "wget *": "ask",
          "*": "ask"
        },
        "task": "ask",
        "external_directory": "ask",
        "question": "ask",
        "webfetch": "ask",
        "websearch": "ask",
        "lsp": "allow",
        "skill": "ask"
      }
    }
  }
}
